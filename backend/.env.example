# HomeCare Hub Email Configuration
# To send real emails to your Gmail/inbox, provide your credentials below:
# For Gmail: Use your Gmail address and generate a 16-character App Password at:
# https://myaccount.google.com/apppasswords

# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=your_email@gmail.com
# EMAIL_HOST_PASSWORD=your_16_char_app_password
# DEFAULT_FROM_EMAIL=HomeCare Hub <your_email@gmail.com>
